# Public origin: exact HTTPS URL in production; no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set true only after completing docs/LAUNCH.md and entering verified firm data
FIRM_LIVE=false
# Resend: verified EU-compatible sender; mail never contains case facts
RESEND_API_KEY=
MAIL_FROM=
# Private malware scanning endpoint. POST raw bytes, bearer authentication.
# Must return {"clean":true,"sha256":"<hash of submitted file>"}; fail closed.
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
# Optional payments; client checkout requires configured terms and accepted mandate
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional approved HTTPS video provider hostname (links entered by staff)
VIDEO_PROVIDER_HOST=
# Vercel cron authentication; long random value
CRON_SECRET=
# HMAC salt for rate limiting (random, >=32 characters)
RATE_LIMIT_SECRET=
